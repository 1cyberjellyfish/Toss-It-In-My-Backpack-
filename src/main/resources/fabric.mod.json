{
  "schemaVersion": 1,
  "id": "tossitinmybackpack",
  "version": "1.0.0",
  "name": "Toss it in my backpack!",
  "description": "Client-side mod that lets you bind a key (default G) to toss the held item directly into the top of your backpack!",
  "authors": [
    "Cyber_Jellyfish"
  ],
  "contact": {
    "homepage": "https://github.com/1cyberjellyfish/Toss-It-In-My-Backpack-",
    "sources": "https://github.com/1cyberjellyfish/Toss-It-In-My-Backpack-"
  },
  "license": "WTFPL",
  "environment": "client",
  "entrypoints": {
    "client": [
      "cyber_jellyfish.tiimb.fabric.TossitinmybackpackFabric"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*"
  }
}
